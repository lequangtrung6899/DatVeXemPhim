@{
    var customer = ViewBag.Customer as Customer;
    var path = (string)(ViewBag.Path ?? "/");
    var currentStatus = Context.Request.Query["status"].ToString();
    var isMoviesListPage = path == "/phim";
    var isNowShowingActive = isMoviesListPage && (string.IsNullOrEmpty(currentStatus) || currentStatus == "Đang chiếu");
    var isComingSoonActive = isMoviesListPage && currentStatus == "Sắp chiếu";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] · PhimHay</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="logo">
                <span class="mark">🎬</span>
                <span>Phim<span class="brand-sub">Hay</span></span>
            </a>
            <nav class="main-nav">
                <a href="/phim?status=Đang chiếu" class="@(isNowShowingActive ? "active" : "")">Phim đang chiếu</a>
                <a href="/phim?status=Sắp chiếu" class="@(isComingSoonActive ? "active" : "")">Phim sắp chiếu</a>
                <a href="/#uu-dai">Ưu đãi</a>
            </nav>
            <form class="search-form" action="/tim-kiem" method="get" id="searchForm" autocomplete="off">
                <button type="submit" aria-label="Tìm kiếm">🔍</button>
                <input type="text" name="q" id="searchInput" placeholder="Tìm phim...">
                <div class="search-suggest" id="searchSuggest"></div>
            </form>
            <div class="header-actions">
                <a href="/gio-hang" class="btn btn-ghost btn-sm" style="position:relative;" title="Giỏ hàng">
                    🛒 Giỏ hàng
                    @{ var cartCount = ViewBag.CartCount as int? ?? 0; }
                    @if (cartCount > 0)
                    {
                        <span style="position:absolute; top:-7px; right:-7px; background:var(--accent); color:#fff; border-radius:999px; padding:1px 6px; font-size:10.5px; font-weight:700;">@cartCount</span>
                    }
                </a>
                @if (customer != null)
                {
                    <a href="/tai-khoan/ve-cua-toi" class="user-chip">
                        <span class="avatar">@customer.FullName.Substring(0, 1)</span>
                        <span>@customer.FullName.Split(' ').Last()</span>
                    </a>
                    <form action="/dang-xuat" method="post" style="margin:0">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-ghost btn-sm" type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a href="/dang-nhap" class="btn btn-ghost btn-sm">Đăng nhập</a>
                    <a href="/dang-ky" class="btn btn-primary btn-sm">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="logo" style="margin-bottom:14px;">
                        <span class="mark">🎬</span>
                        <span>Phim<span class="brand-sub">Hay</span></span>
                    </div>
                    <p style="max-width:280px; font-size:13.5px;">Đặt vé xem phim nhanh chóng, chọn ghế trực tuyến và nhận ưu đãi thành viên mỗi ngày.</p>
                </div>
                <div>
                    <h4>Khám phá</h4>
                    <ul>
                        <li><a href="/phim?status=Đang chiếu">Phim đang chiếu</a></li>
                        <li><a href="/phim?status=Sắp chiếu">Phim sắp chiếu</a></li>
                        <li><a href="/tim-kiem">Tìm kiếm</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Tài khoản</h4>
                    <ul>
                        <li><a href="/dang-nhap">Đăng nhập</a></li>
                        <li><a href="/dang-ky">Đăng ký</a></li>
                        <li><a href="/tai-khoan/ve-cua-toi">Vé của tôi</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Hỗ trợ</h4>
                    <ul>
                        <li><a href="/ho-tro/cau-hoi-thuong-gap">Câu hỏi thường gặp</a></li>
                        <li><a href="/ho-tro/doi-tra-ve">Chính sách đổi/trả vé</a></li>
                        <li><a href="/ho-tro/lien-he">Liên hệ</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© 2026 PhimHay — Demo project built on the provided database schema.</span>
                <span>ASP.NET Core MVC edition</span>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

    <script>
        (function () {
            const input = document.getElementById('searchInput');
            const box = document.getElementById('searchSuggest');
            if (!input || !box) return;

            let debounceTimer = null;
            let items = [];
            let activeIndex = -1;

            function hide() { box.classList.remove('open'); box.innerHTML = ''; items = []; activeIndex = -1; }

            function render(movies) {
                items = movies;
                activeIndex = -1;
                if (movies.length === 0) { hide(); return; }

                box.innerHTML = movies.map((m, i) => `
                    <a href="/phim/${m.id}" class="search-suggest-item" data-idx="${i}">
                        <img src="${m.posterUrl || ''}" onerror="this.style.visibility='hidden'" alt="">
                        <div class="search-suggest-info">
                            <span class="search-suggest-title">${escapeHtml(m.title)}</span>
                            <span class="search-suggest-meta">${m.duration} phút · ${escapeHtml(m.status)}</span>
                        </div>
                    </a>
                `).join('');
                box.classList.add('open');
            }

            function escapeHtml(s) {
                const d = document.createElement('div');
                d.textContent = s;
                return d.innerHTML;
            }

            function highlight(idx) {
                const links = box.querySelectorAll('.search-suggest-item');
                links.forEach(l => l.classList.remove('active'));
                if (idx >= 0 && idx < links.length) {
                    links[idx].classList.add('active');
                    links[idx].scrollIntoView({ block: 'nearest' });
                }
                activeIndex = idx;
            }

            input.addEventListener('input', () => {
                const q = input.value.trim();
                clearTimeout(debounceTimer);
                if (q.length < 2) { hide(); return; }
                debounceTimer = setTimeout(async () => {
                    try {
                        const res = await fetch(`/tim-kiem/goi-y?q=${encodeURIComponent(q)}`);
                        const data = await res.json();
                        render(data);
                    } catch (e) { hide(); }
                }, 250);
            });

            input.addEventListener('keydown', (e) => {
                if (!box.classList.contains('open')) return;
                if (e.key === 'ArrowDown') { e.preventDefault(); highlight(Math.min(activeIndex + 1, items.length - 1)); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(Math.max(activeIndex - 1, 0)); }
                else if (e.key === 'Enter' && activeIndex >= 0) { e.preventDefault(); window.location.href = `/phim/${items[activeIndex].id}`; }
                else if (e.key === 'Escape') { hide(); }
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('#searchForm')) hide();
            });
        })();
    </script>
</body>
</html>
