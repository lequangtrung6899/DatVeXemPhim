@model SearchVM
@{
    ViewData["Title"] = Model.Title;
}

<div class="container" style="padding-top:32px;">
    <div class="section-head">
        <h1 class="section-title">Kết quả tìm kiếm @(!string.IsNullOrEmpty(Model.Q) ? $"cho \"{Model.Q}\"" : "")</h1>
    </div>

    <form class="search-form page-search-form" action="/tim-kiem" method="get" id="pageSearchForm" autocomplete="off" style="width:100%; max-width:420px; margin-bottom:14px;">
        <button type="submit">🔍</button>
        <input type="text" name="q" id="pageSearchInput" value="@Model.Q" placeholder="Tìm phim...">
        <div class="search-suggest" id="pageSearchSuggest"></div>
    </form>

    @if (Model.PopularKeywords.Count > 0)
    {
        <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:28px;">
            <span style="color:var(--text-dim); font-size:13px; align-self:center;">Gợi ý:</span>
            @foreach (var kw in Model.PopularKeywords)
            {
                <a href="/tim-kiem?q=@Uri.EscapeDataString(kw)" class="badge-inline" style="text-decoration:none;">@kw</a>
            }
        </div>
    }

    @if (string.IsNullOrEmpty(Model.Q))
    {
        <div class="empty-state"><div class="icon">🔍</div><p>Nhập tên phim để tìm kiếm.</p></div>
    }
    else if (Model.Movies.Count == 0)
    {
        <div class="empty-state"><div class="icon">🎬</div><p>Không tìm thấy phim nào phù hợp với "@Model.Q".</p></div>
    }
    else
    {
        <div class="movie-grid">
            @foreach (var movie in Model.Movies)
            {
                @await Html.PartialAsync("_MovieCard", movie)
            }
        </div>
    }

    @if (Model.SuggestedMovies.Count > 0)
    {
        <div class="section" style="margin-top:@(Model.Movies.Count == 0 ? "0" : "48px");">
            <div class="section-head">
                <h2 class="section-title" style="font-size:20px;">Có thể bạn quan tâm</h2>
            </div>
            <div class="movie-grid">
                @foreach (var movie in Model.SuggestedMovies)
                {
                    @await Html.PartialAsync("_MovieCard", movie)
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('pageSearchInput');
            const box = document.getElementById('pageSearchSuggest');
            if (!input || !box) return;

            let debounceTimer = null;
            let items = [];
            let activeIndex = -1;

            function hide() { box.classList.remove('open'); box.innerHTML = ''; items = []; activeIndex = -1; }

            function escapeHtml(s) {
                const d = document.createElement('div');
                d.textContent = s;
                return d.innerHTML;
            }

            function render(movies) {
                items = movies;
                activeIndex = -1;
                if (movies.length === 0) { hide(); return; }

                box.innerHTML = movies.map((m, i) => `
                    <a href="/phim/${m.id}" class="search-suggest-item" data-idx="${i}">
                        <img src="${m.posterUrl || ''}" onerror="this.style.visibility='hidden'" alt="">
                        <div class="search-suggest-info">
                            <span class="search-suggest-title">${escapeHtml(m.title)}</span>
                            <span class="search-suggest-meta">${m.duration} phút · ${escapeHtml(m.status)}</span>
                        </div>
                    </a>
                `).join('');
                box.classList.add('open');
            }

            function highlight(idx) {
                const links = box.querySelectorAll('.search-suggest-item');
                links.forEach(l => l.classList.remove('active'));
                if (idx >= 0 && idx < links.length) {
                    links[idx].classList.add('active');
                    links[idx].scrollIntoView({ block: 'nearest' });
                }
                activeIndex = idx;
            }

            input.addEventListener('input', () => {
                const q = input.value.trim();
                clearTimeout(debounceTimer);
                if (q.length < 2) { hide(); return; }
                debounceTimer = setTimeout(async () => {
                    try {
                        const res = await fetch(`/tim-kiem/goi-y?q=${encodeURIComponent(q)}`);
                        const data = await res.json();
                        render(data);
                    } catch (e) { hide(); }
                }, 250);
            });

            input.addEventListener('keydown', (e) => {
                if (!box.classList.contains('open')) return;
                if (e.key === 'ArrowDown') { e.preventDefault(); highlight(Math.min(activeIndex + 1, items.length - 1)); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(Math.max(activeIndex - 1, 0)); }
                else if (e.key === 'Enter' && activeIndex >= 0) { e.preventDefault(); window.location.href = `/phim/${items[activeIndex].id}`; }
                else if (e.key === 'Escape') { hide(); }
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('#pageSearchForm')) hide();
            });
        })();
    </script>
}
