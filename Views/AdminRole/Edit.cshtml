@model DatVeXemPhim.Models.Role
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.RoleId == 0 ? "Thêm vai trò" : "Sửa vai trò";
}
<h1>@ViewData["Title"]</h1>

<form class="admin-form" method="post" action="/quan-tri/vai-tro/luu">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@Model.RoleId">

    <label>Tên vai trò</label>
    @if (Model.RoleName == "Admin")
    {
        <input type="text" name="roleName" value="@Model.RoleName" readonly style="opacity:.7;">
        <small class="admin-hint">Vai trò "Admin" là vai trò gốc của hệ thống nên không thể đổi tên.</small>
    }
    else
    {
        <input type="text" name="roleName" value="@Model.RoleName" required>
    }

    <div class="admin-actions">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a href="/quan-tri/vai-tro" class="btn btn-ghost">Hủy</a>
    </div>
</form>
