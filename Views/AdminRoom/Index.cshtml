@model List<DatVeXemPhim.Models.Room>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý phòng chiếu";
}
<div class="admin-toolbar">
    <h1 style="margin:0;">Quản lý phòng chiếu</h1>
    <a href="/quan-tri/phong-chieu/them" class="btn btn-primary btn-sm">+ Thêm phòng</a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">Chưa có phòng chiếu nào.</div>
}
else
{
    <table class="admin-table">
        <thead><tr><th>Tên phòng</th><th>Tổng số ghế</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.RoomName</td>
                    <td>@r.TotalSeats</td>
                    <td><span class="admin-badge @(r.IsActive ? "admin-badge-ok" : "admin-badge-muted")">@(r.IsActive ? "Hoạt động" : "Ngừng")</span></td>
                    <td>
                        <a href="/quan-tri/phong-chieu/@r.RoomId/ghe" class="btn btn-ghost btn-sm">Quản lý ghế</a>
                        <a href="/quan-tri/phong-chieu/@r.RoomId/sua" class="btn btn-ghost btn-sm">Sửa</a>
                        <form class="admin-inline-form" method="post" action="/quan-tri/phong-chieu/@r.RoomId/xoa" onsubmit="return confirm('Xóa phòng chiếu này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm admin-link-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_AdminPagination", (PaginationVM)ViewBag.Pagination)
}
