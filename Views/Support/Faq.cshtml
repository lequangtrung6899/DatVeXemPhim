@{
    ViewData["Title"] = "Câu hỏi thường gặp";
}

<div class="container" style="padding-top:32px; padding-bottom:60px; max-width:820px;">
    <div class="section-head">
        <h1 class="section-title">Câu hỏi thường gặp</h1>
    </div>

    <div style="display:flex; flex-direction:column; gap:12px;">
        @{
            var faqs = new (string Q, string A)[]
            {
                ("Làm sao để đặt vé xem phim?", "Chọn phim bạn muốn xem, chọn suất chiếu, chọn ghế trên sơ đồ rạp, chọn thêm combo bắp nước (nếu muốn), rồi bấm \"Thêm vào giỏ hàng\". Trong Giỏ hàng, bạn có thể nhập/chọn mã giảm giá — tiền sẽ tự động tính lại, rồi bấm \"Tiến hành thanh toán\" để quét mã QR chuyển khoản. Bạn cần đăng nhập trước khi đặt vé."),
                ("Tôi có thể giữ ghế trong bao lâu trước khi phải thanh toán?", "Khi bạn chọn ghế, hệ thống sẽ giữ tạm ghế đó cho bạn trong 5 phút để hoàn tất thêm vào giỏ hàng. Sau khi đã vào giỏ hàng, ghế được giữ chắc chắn, nhưng nếu bạn bỏ quên giỏ hàng quá lâu mà không thanh toán, hệ thống sẽ tự động hủy món đó để nhả ghế lại cho người khác."),
                ("Tôi có thể hủy vé đã đặt không?", "Có. Vào mục \"Vé của tôi\" > chọn vé cần hủy > bấm \"Yêu cầu hoàn tiền / hủy vé\". Vé chỉ có thể tự gửi yêu cầu khi còn ở trạng thái \"Đã thanh toán\" và suất chiếu chưa bắt đầu trong vòng 2 giờ tới. Vé chỉ thực sự bị hủy và tiền chỉ thực sự được hoàn sau khi cả Nhân viên và Admin xét duyệt. Xem chi tiết ở trang Chính sách đổi/trả vé."),
                ("Thanh toán trên website có an toàn không?", "Trang thanh toán hiển thị mã QR chuẩn VietQR kèm sẵn số tiền cần chuyển (quét là tự động điền đúng số tiền, không cần gõ lại). Đây vẫn là chức năng mô phỏng phục vụ mục đích học tập/demo — không có giao dịch ngân hàng thật nào được đối soát."),
                ("Áp dụng mã giảm giá ở đâu?", "Ngay trong trang Giỏ hàng: nhập mã vào ô \"Mã giảm giá\" rồi bấm \"Áp dụng\", hoặc chọn nhanh một mã từ danh sách gợi ý bên dưới. Tổng tiền được tính lại ngay lập tức, không cần đợi đến bước thanh toán mới biết."),
                ("Làm sao để nhận ưu đãi thành viên?", "Mỗi lần thanh toán thành công, bạn được cộng điểm tích lũy theo tổng giá trị đơn hàng. Khi đủ điểm, hạng thành viên của bạn sẽ tự động nâng lên (Bạc, Vàng, Kim Cương) và mở khoá thêm ưu đãi."),
                ("Tôi quên mã vé/mã giao dịch thì tra cứu ở đâu?", "Vào mục \"Vé của tôi\" để xem lại toàn bộ vé đã đặt kèm mã vé, trạng thái và tổng tiền."),
            };
        }
        @foreach (var (q, a) in faqs)
        {
            <details class="review-card" style="padding:16px 20px;">
                <summary style="cursor:pointer; font-weight:700; list-style:none;">@q</summary>
                <p style="color:var(--text-dim); font-size:14px; margin:10px 0 0; line-height:1.6;">@a</p>
            </details>
        }
    </div>

    <p style="margin-top:28px; color:var(--text-dim); font-size:14px;">
        Không tìm thấy câu trả lời bạn cần? <a href="/ho-tro/lien-he" style="color:var(--accent); font-weight:600;">Liên hệ với chúng tôi</a>.
    </p>
</div>
