@model List<DatVeXemPhim.Models.Movie>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý phim";
}
<div class="admin-toolbar">
    <h1 style="margin:0;">Quản lý phim</h1>
    <a href="/quan-tri/phim/them" class="btn btn-primary btn-sm">+ Thêm phim</a>
</div>

<form method="get" class="admin-search-form" style="margin-bottom:16px;">
    <input type="text" name="q" placeholder="Tìm theo tên phim..." value="@ViewBag.Q">
    <button type="submit" class="btn btn-ghost btn-sm">Tìm</button>
</form>

@if (Model.Count == 0)
{
    <div class="admin-empty">Không tìm thấy phim nào.</div>
}
else
{
    <table class="admin-table">
        <thead><tr><th>Tên phim</th><th>Thời lượng</th><th>Khởi chiếu</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Title</td>
                    <td>@m.Duration phút</td>
                    <td>@m.ReleaseDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @{
                            var badge = m.Status switch
                            {
                                "Đang chiếu" => "admin-badge-ok",
                                "Sắp chiếu" => "admin-badge-warn",
                                _ => "admin-badge-muted"
                            };
                        }
                        <span class="admin-badge @badge">@m.Status</span>
                    </td>
                    <td>
                        <a href="/quan-tri/phim/@m.MovieId/sua" class="btn btn-ghost btn-sm">Sửa</a>
                        <form class="admin-inline-form" method="post" action="/quan-tri/phim/@m.MovieId/xoa" onsubmit="return confirm('Xóa phim này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm admin-link-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
