@model DatVeXemPhim.Models.ViewModels.PaymentSuccessVM
@{
    ViewData["Title"] = "Thanh toán thành công";
    var formatVND = (Func<decimal, string>)ViewBag.FormatVND;
}

<div class="container">
    <div class="ticket-card">
        <div class="ticket-top">
            <div class="ticket-check">✓</div>
            <h2 style="margin:0 0 6px;">Thanh toán thành công!</h2>
            <p style="color:var(--text-dim); font-size:14px;">
                @(Model.TicketIds.Count > 1 ? $"Đã xác nhận {Model.TicketIds.Count} vé" : "Đã xác nhận vé của bạn")
                — tổng cộng @formatVND(Model.Total).
            </p>
        </div>
        <div class="ticket-body">
            @if (Model.TicketIds.Count == 0)
            {
                <p style="text-align:center; color:var(--text-dim);">Không tìm thấy vé nào vừa thanh toán.</p>
            }
            else
            {
                @foreach (var id in Model.TicketIds)
                {
                    <div class="ticket-row">
                        <span class="label">Vé #@id</span>
                        <a href="/ve/@id" style="color:var(--accent); font-weight:700;">Xem chi tiết →</a>
                    </div>
                }
            }

            <div class="ticket-actions" style="margin-top:20px;">
                <a href="/tai-khoan/ve-cua-toi" class="btn btn-primary btn-block">Xem tất cả vé của tôi</a>
                <a href="/" class="btn btn-ghost btn-block">Tiếp tục khám phá phim</a>
            </div>
        </div>
    </div>
</div>
