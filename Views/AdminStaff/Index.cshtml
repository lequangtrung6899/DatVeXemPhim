@model List<DatVeXemPhim.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý tài khoản nhân viên";
}
<div class="admin-toolbar">
    <h1 style="margin:0;">Quản lý tài khoản nhân viên</h1>
    <a href="/quan-tri/nhan-vien/them" class="btn btn-primary btn-sm">+ Thêm nhân viên</a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">Chưa có tài khoản nhân viên nào.</div>
}
else
{
    <table class="admin-table">
        <thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Username</td>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.Role.RoleName</td>
                    <td><span class="admin-badge @(u.IsActive ? "admin-badge-ok" : "admin-badge-danger")">@(u.IsActive ? "Hoạt động" : "Đã khóa")</span></td>
                    <td>
                        <a href="/quan-tri/nhan-vien/@u.UserId/sua" class="btn btn-ghost btn-sm">Sửa</a>
                        <form class="admin-inline-form" method="post" action="/quan-tri/nhan-vien/@u.UserId/khoa">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm @(u.IsActive ? "admin-link-danger" : "")">@(u.IsActive ? "Khóa" : "Mở khóa")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
