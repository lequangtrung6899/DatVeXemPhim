@model List<DatVeXemPhim.Models.Combo>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Combo";
}
<div class="admin-toolbar">
    <h1 style="margin:0;">Quản lý Combo</h1>
    <a href="/quan-tri/combo/them" class="btn btn-primary btn-sm">+ Thêm combo</a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">Chưa có combo nào.</div>
}
else
{
    <table class="admin-table">
        <thead><tr><th>Tên combo</th><th>Mô tả</th><th>Giá</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.ComboName</td>
                    <td>@c.Description</td>
                    <td>@ViewBag.FormatVND(c.Price)</td>
                    <td><span class="admin-badge @(c.IsActive ? "admin-badge-ok" : "admin-badge-muted")">@(c.IsActive ? "Đang bán" : "Ngừng bán")</span></td>
                    <td>
                        <a href="/quan-tri/combo/@c.ComboId/sua" class="btn btn-ghost btn-sm">Sửa</a>
                        <form class="admin-inline-form" method="post" action="/quan-tri/combo/@c.ComboId/xoa" onsubmit="return confirm('Xóa combo này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm admin-link-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_AdminPagination", (PaginationVM)ViewBag.Pagination)
}
