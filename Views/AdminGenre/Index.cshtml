@model List<DatVeXemPhim.Models.Genre>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý thể loại";
}
<div class="admin-toolbar">
    <h1 style="margin:0;">Quản lý thể loại</h1>
    <a href="/quan-tri/the-loai/them" class="btn btn-primary btn-sm">+ Thêm thể loại</a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">Chưa có thể loại nào.</div>
}
else
{
    <table class="admin-table">
        <thead><tr><th>#</th><th>Tên thể loại</th><th></th></tr></thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td>@g.GenreId</td>
                    <td>@g.GenreName</td>
                    <td>
                        <a href="/quan-tri/the-loai/@g.GenreId/sua" class="btn btn-ghost btn-sm">Sửa</a>
                        <form class="admin-inline-form" method="post" action="/quan-tri/the-loai/@g.GenreId/xoa" onsubmit="return confirm('Xóa thể loại này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm admin-link-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
